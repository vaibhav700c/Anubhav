# Anubhav Backend Environment Variables
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
MOCK_MODE=True

# Database (defaults to SQLite if PostgreSQL is not provided)
DATABASE_URL=sqlite:///./anubhav.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anubhav

# Sarvam AI (STT Saaras, LLM Sarvam-105B, TTS Bulbul)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai

# Hume AI (EVI WebSocket)
HUME_API_KEY=your_hume_api_key_here
HUME_EVI_WS_URL=wss://api.hume.ai/v0/evi/chat

# Voice & Speech Scoring Weights (Sum to 1.0)
WEIGHT_CONTINUITY=0.25
WEIGHT_PAUSE_CONTROL=0.20
WEIGHT_FILLER_RATE=0.25
WEIGHT_REPETITION_RATE=0.15
WEIGHT_SELF_CORRECTION=0.15
